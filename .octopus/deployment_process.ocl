step "run-a-script" {
    name = "Run a Script: Let's Go (To the Moon!) And Here I Am"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.Script.ScriptBody = "echo \"hi\""
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }
        worker_pool = "hosted-ubuntu"

        container {
            feed = "dockerhub"
            image = "octopusdeploy/worker-tools:6.4.0"
        }
    }
}

step "update-amazon-ecs-service" {
    name = "Update Amazon ECS Service"
    properties = {
        Octopus.Action.TargetRoles = "aks"
    }

    action {
        action_type = "Octopus.AwsUpdateEcsService"
        properties = {
            Octopus.Action.Aws.Ecs.Update.ContainerUpdates = "[{\"containerName\":\"asdf\",\"packageReference\":\"asdf\"}]"
            Octopus.Action.Aws.Ecs.Update.ServiceName = "serv"
            Octopus.Action.Aws.Ecs.Update.TargetTaskDefinitionName = "task"
            Octopus.Action.Aws.Ecs.Update.TemplateTaskDefinitionName = "asdf"
            Octopus.Action.Aws.Ecs.WaitOption = "{\"type\":\"WaitWithTimeout\",\"timeoutMinutes\":\"30\"}"
            OctopusUseBundledTooling = "False"
        }
        worker_pool = "hosted-ubuntu"

        container {
            feed = "dockerhub"
            image = "octopusdeploy/worker-tools:6.5.0-ubuntu.22.04"
        }

        packages "asdf" {
            acquisition_location = "NotAcquired"
            feed = "dockerhub"
            package_id = "asdf/asdf"
        }
    }
}

step "run-a-script-version-bumbum" {
    name = "Run a Script: Version bumbum"
    properties = {
        Octopus.Action.TargetRoles = "drop"
    }

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = "write-host 'hi'"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = ""
    }
}